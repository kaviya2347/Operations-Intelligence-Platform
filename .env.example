# Copy to .env. Every setting is optional: without a model the copilot quotes the retrieved passages.

# auto = Claude if ANTHROPIC_API_KEY is set, else a running Ollama model, else extractive answers
OIP_LLM_PROVIDER=auto

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
OIP_ANTHROPIC_MODEL=claude-sonnet-5-5

# Local model through Ollama (https://ollama.com): ollama pull llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OIP_OLLAMA_MODEL=llama3.1

# Embeddings: default is TF-IDF + SVD (no download). "st" uses sentence-transformers all-MiniLM-L6-v2.
# OIP_EMBEDDER=st

# Where generated data, the warehouse and artifacts live
# OIP_DATA_DIR=./data

# Salt for hashing customer identifiers (keep secret in a real deployment)
# OIP_HASH_SALT=change-me
